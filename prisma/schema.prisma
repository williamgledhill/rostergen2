generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppUserRole {
  ADMIN
  EDITOR
}

enum AppDayOfWeek {
  Mon
  Tue
  Wed
  Thu
  Fri
  Sat
  Sun
}

enum AppScheduleWeekType {
  DEFAULT
  WEEK_A
  WEEK_B
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Roster {
  id        Int      @id @default(autoincrement())
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id        Int      @id @default(autoincrement())
  type      String   // front, tour, prep, gallery, break, tidy, etc.
  label     String
  start     DateTime
  end       DateTime

  // relations
  roster   Roster   @relation(fields: [rosterId], references: [id])
  rosterId Int
  employee Employee @relation(fields: [employeeId], references: [id])
  employeeId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rosterId])
  @@index([employeeId])
  @@index([start, end])
}

model AppPerson {
  id        String   @id
  name      String
  email     String?
  fortnightAnchorDate String?
  schedule  Json
  fortnight Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  daySchedules AppPersonDaySchedule[]
}

model AppTaskTemplate {
  id                     String   @id
  name                   String
  description            String   @default("")
  category               String?
  color                  String?
  mustManned             Boolean  @default(false)
  overwriteExistingTasks Boolean  @default(false)
  attendedByAll          Boolean  @default(false)
  autogenStart           String?
  autogenEnd             String?
  regularDays            Json?
  regularTimes           Json?
  regularTimesByDay      Json?
  regularDayWindows      Json?
  minPerEmployeePerDay   Int      @default(0)
  maxPerEmployeePerDay   Int      @default(0)
  durationMinutes        Int      @default(0)
  maxConsecutiveMinutes  Int      @default(0)
  waitingMinutes         Int      @default(0)
  packingMinutes         Int      @default(0)
  limitPerDay            Int      @default(0)
  maxConcurrentPerTimeslot Int    @default(0)
  schoolTourImportTarget Boolean  @default(false)
  enabled                Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  regularDayRules        AppTaskTemplateRegularDay[]
  timeSlots              AppTaskTemplateTimeSlot[]
  dayWindows             AppTaskTemplateDayWindow[]
}

model AppSettings {
  id          String   @id
  hoursByDay  Json
  upcomingDays Int     @default(7)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dayHours    AppSettingsDayHours[]
}

model AppRoster {
  id           String   @id
  date         DateTime @unique
  title        String
  status       String   @default("Draft")
  updatedLabel String   @default("-")
  tours        Int      @default(0)
  people       Int      @default(0)
  employees    Json?
  tasks        Json?
  hoursStart   String?
  hoursEnd     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  rosterEmployees AppRosterEmployee[]
  rosterTasks     AppRosterTask[]

  @@index([date])
}

model AppPersonDaySchedule {
  id        Int                 @id @default(autoincrement())
  personId  String
  weekType  AppScheduleWeekType
  dayOfWeek AppDayOfWeek
  enabled   Boolean             @default(false)
  start     String
  end       String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  person    AppPerson           @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, weekType, dayOfWeek])
  @@index([personId, weekType])
}

model AppTaskTemplateRegularDay {
  id         Int            @id @default(autoincrement())
  templateId String
  dayOfWeek  AppDayOfWeek
  createdAt  DateTime       @default(now())
  template   AppTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, dayOfWeek])
  @@index([templateId])
}

model AppTaskTemplateTimeSlot {
  id         Int             @id @default(autoincrement())
  templateId String
  dayOfWeek  AppDayOfWeek?
  time       String
  createdAt  DateTime        @default(now())
  template   AppTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, dayOfWeek])
}

model AppTaskTemplateDayWindow {
  id         Int             @id @default(autoincrement())
  templateId String
  dayOfWeek  AppDayOfWeek
  start      String?
  end        String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  template   AppTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, dayOfWeek])
  @@index([templateId])
}

model AppSettingsDayHours {
  id         Int          @id @default(autoincrement())
  settingsId String
  dayOfWeek  AppDayOfWeek
  start      String
  end        String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  settings   AppSettings  @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, dayOfWeek])
  @@index([settingsId])
}

model AppRosterEmployee {
  id         Int        @id @default(autoincrement())
  rosterId    String
  externalId String
  name       String
  startTime  String?
  endTime    String?
  position   Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  roster     AppRoster  @relation(fields: [rosterId], references: [id], onDelete: Cascade)

  @@unique([rosterId, position])
  @@index([rosterId])
  @@index([rosterId, externalId])
}

model AppRosterTask {
  id                  Int        @id @default(autoincrement())
  rosterId            String
  externalId          String
  type                String
  label               String
  col                 Int
  startRow            Int
  span                Int
  color               String?
  waitingMinutes      Int        @default(0)
  packingMinutes      Int        @default(0)
  employeeId          String?
  locked              Boolean    @default(false)
  isLocked            Boolean    @default(false)
  readOnly            Boolean    @default(false)
  position            Int
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  roster              AppRoster  @relation(fields: [rosterId], references: [id], onDelete: Cascade)

  @@unique([rosterId, position])
  @@index([rosterId])
  @@index([rosterId, col, startRow])
  @@index([rosterId, employeeId])
}

model AppUser {
  id                String              @id @default(cuid())
  email             String              @unique
  name              String
  role              AppUserRole         @default(EDITOR)
  passwordHash      String
  isActive          Boolean             @default(true)
  mustChangePassword Boolean            @default(false)
  totpEnabled       Boolean             @default(false)
  totpSecretCiphertext String?
  totpSecretNonce   String?
  totpRecoveryCodes Json?
  lastLoginAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sessions          AppSession[]
  loginChallenges   AppLoginChallenge[]
  mfaSetup          AppMfaSetup?
}

model AppSession {
  id              String   @id @default(cuid())
  userId          String
  tokenHash       String   @unique
  expiresAt       DateTime
  mfaSatisfiedAt  DateTime?
  ipAddress       String?
  userAgent       String?
  lastSeenAt      DateTime @default(now())
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AppLoginChallenge {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AppMfaSetup {
  id               String   @id @default(cuid())
  userId           String   @unique
  secretCiphertext String
  secretNonce      String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
