generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppUserRole {
  ADMIN
  EDITOR
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Roster {
  id        Int      @id @default(autoincrement())
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id        Int      @id @default(autoincrement())
  type      String   // front, tour, prep, gallery, break, tidy, etc.
  label     String
  start     DateTime
  end       DateTime

  // relations
  roster   Roster   @relation(fields: [rosterId], references: [id])
  rosterId Int
  employee Employee @relation(fields: [employeeId], references: [id])
  employeeId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rosterId])
  @@index([employeeId])
  @@index([start, end])
}

model AppPerson {
  id        String   @id
  name      String
  email     String?
  schedule  Json
  fortnight Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppTaskTemplate {
  id                     String   @id
  name                   String
  description            String   @default("")
  category               String?
  color                  String?
  mustManned             Boolean  @default(false)
  autogenStart           String?
  autogenEnd             String?
  regularDays            Json?
  regularTimes           Json?
  regularTimesByDay      Json?
  regularDayWindows      Json?
  minPerEmployeePerDay   Int      @default(0)
  maxPerEmployeePerDay   Int      @default(0)
  durationMinutes        Int      @default(0)
  maxConsecutiveMinutes  Int      @default(0)
  waitingMinutes         Int      @default(0)
  packingMinutes         Int      @default(0)
  limitPerDay            Int      @default(0)
  enabled                Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model AppSettings {
  id          String   @id
  hoursByDay  Json
  upcomingDays Int     @default(7)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppRoster {
  id           String   @id
  date         DateTime @unique
  title        String
  status       String   @default("Draft")
  updatedLabel String   @default("-")
  tours        Int      @default(0)
  people       Int      @default(0)
  employees    Json?
  tasks        Json?
  hoursStart   String?
  hoursEnd     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
}

model AppUser {
  id                String              @id @default(cuid())
  email             String              @unique
  name              String
  role              AppUserRole         @default(EDITOR)
  passwordHash      String
  isActive          Boolean             @default(true)
  mustChangePassword Boolean            @default(false)
  totpEnabled       Boolean             @default(false)
  totpSecretCiphertext String?
  totpSecretNonce   String?
  totpRecoveryCodes Json?
  lastLoginAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sessions          AppSession[]
  loginChallenges   AppLoginChallenge[]
  mfaSetup          AppMfaSetup?
}

model AppSession {
  id              String   @id @default(cuid())
  userId          String
  tokenHash       String   @unique
  expiresAt       DateTime
  mfaSatisfiedAt  DateTime?
  ipAddress       String?
  userAgent       String?
  lastSeenAt      DateTime @default(now())
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AppLoginChallenge {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AppMfaSetup {
  id               String   @id @default(cuid())
  userId           String   @unique
  secretCiphertext String
  secretNonce      String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
